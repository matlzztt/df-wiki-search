# ── Generated index ───────────────────────────────────────────────────────
# df_wiki_v2.db is built by ingest.py and is fully reproducible. At ~119 MB
# it also exceeds GitHub's 100 MB hard limit. Rebuild: python ingest.py
*.db
*.db.tmp
*.sqlite
*.sqlite3

# Compressed too. `*.db` does not match `df_wiki_v2.db.gz` -- the name ends in
# .gz -- so a 33 MB build artifact sat untracked-and-unignored, one `git add -A`
# away from being committed to a public repo permanently. The reasoning above
# does not change when the file is zipped. Ship a prebuilt index as a release
# asset, never as a tracked file.
*.db.gz
*.db.bz2
*.db.zst
*.db.zip

# ── Source dump ───────────────────────────────────────────────────────────
# df_wiki.xml is a third-party MediaWiki export (64 MB), not ours to ship.
# See README "Obtaining the dump".
*.xml
*.xml.gz
*.xml.bz2

# ...except the CI fixture, which is ours and is tiny.
!tests/fixture_wiki.xml

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Editor / OS ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ── Local agent config ────────────────────────────────────────────────────
.claude/settings.local.json
.mcp.json
